<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.CAMERA" />

    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.camera.front"
        android:required="false" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.LChat">

        <activity
            android:name=".auth.AuthActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".MainActivity"
            android:exported="false" />
        <activity
            android:name=".snap.CreateSnapActivity"
            android:exported="false"
            android:theme="@style/Theme.LChat.Dark"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".snap.ChooseRecipientsActivity"
            android:exported="false" />
        <activity
            android:name=".snap.ViewSnapActivity"
            android:exported="false"
            android:theme="@style/Theme.LChat.Dark" />
        <activity
            android:name=".chat.ChatActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".chat.NewChatActivity"
            android:exported="false" />
        <activity
            android:name=".call.CallActivity"
            android:exported="false"
            android:showWhenLocked="true" />
        <activity
            android:name=".group.CreateGroupActivity"
            android:exported="false" />
        <activity android:name=".friends.FriendsActivity" android:exported="false" />
        <activity
            android:name=".group.GroupSettingsActivity"
            android:exported="false" />
        <activity
            android:name=".settings.SettingsActivity"
            android:exported="false" />
        <activity
            android:name=".story.ViewStoryActivity"
            android:exported="false"
            android:theme="@style/Theme.LChat.Dark" />

    </application>

</manifest>
